{
  "contract": "STOCK-A-RUNTIME-DEFAULTS/R9",
  "paths": {
    "workspace_root": "G:/codex work/Stock A",
    "delivery_root": "G:/codex work/Stock A 交付",
    "release_root": "G:/codex work/Stock A 交付/发布包",
    "runtime_data_root": "G:/codex work/Stock A 交付/运行数据",
    "private_configuration_root": "G:/codex work/Stock A/config/private",
    "temporary_root": "G:/codex_tmp",
    "configuration_root": "G:/codex work/Stock A/config"
  },
  "services": {
    "production": {
      "host": "127.0.0.1",
      "port": 28765
    },
    "development": {
      "host": "127.0.0.1",
      "port": 28766
    }
  },
  "postgresql": {
    "host": "127.0.0.1",
    "port": 5432,
    "database": "stock_a",
    "business_schema": "stock",
    "data_directory": "G:/Postgres/data",
    "wal_directory": "G:/Postgres/data/pg_wal",
    "log_directory": "G:/Postgres/log",
    "manual_export_and_backup_directory": "G:/Postgres/backups",
    "temp_tablespaces": ""
  },
  "source_policy": {
    "configured_tdx_source_roots": [
      "D:/new_tdx"
    ],
    "all_source_roots_read_only": true,
    "require_phase0_before_dependent_operations": true,
    "vipdata_official": {
      "page_url": "https://www.tdx.com.cn/article/vipdata.html",
      "package_url": "https://data.tdx.com.cn/vipdoc/hsjday.zip",
      "metadata_url": "https://data.tdx.com.cn/vipdoc/_hsjdayinfo.js"
    },
    "baostock_supplement": {
      "contract": "STOCK-A-OPTIONAL-BAOSTOCK-SUPPLEMENT/R1",
      "request_policy": "NOT_REQUESTED",
      "reason_code": "OPTIONAL_SOURCE_NOT_REQUESTED",
      "required_for_core": false,
      "request_budget": {
        "max_logins": 1,
        "max_queries_per_target_session": 10,
        "query_timeout_seconds": 30
      }
    }
  },
  "startup_policy": {
    "require_explicit_validated_configuration": true,
    "require_pg_data_directory_match": true,
    "allow_legacy_postgres_writes": false,
    "allow_automatic_pg_initialization": false,
    "allow_database_creation": false,
    "allow_schema_creation": false,
    "allow_automatic_old_data_migration": false,
    "allow_port_takeover": false,
    "require_database_schema_application_instance_and_migration_match": true,
    "allow_automatic_identity_bootstrap": false,
    "require_business_login_match": true
  },
  "git_content_policy": {
    "business_and_normative_documents_only": true,
    "tests_allowed": false,
    "stage_tasks_reports_receipts_evidence_artifacts_allowed": false,
    "credentials_and_runtime_data_allowed": false
  },
  "configuration_policy": {
    "contract": "STOCK-A-CONFIGURATION-POLICY/R1",
    "root": "G:/codex work/Stock A/config",
    "root_only": true,
    "public_files": [
      {
        "path": "runtime.defaults.json",
        "role": "BUSINESS_RUNTIME_CONFIGURATION",
        "contract": "STOCK-A-RUNTIME-DEFAULTS/R9",
        "consumer": "application startup / configuration resolver; source-vipdata reads source_policy.vipdata_official; SOURCE_INGRESS P00/P02 reads source_policy.baostock_supplement"
      },
      {
        "path": "contracts/day-chain.contract.json",
        "role": "BUSINESS_PIPELINE_DESIGN_CONTRACT",
        "contract": "STOCK-A-DAY-CHAIN/R11",
        "consumer": "stock_a.contracts.load_day_chain_contract（唯一入口清单）"
      },
      {
        "path": "contracts/day-chain/pipeline.json",
        "role": "BUSINESS_PIPELINE_DESIGN_CONTRACT_MODULE",
        "contract": "STOCK-A-DAY-CHAIN/R11",
        "consumer": "stock_a.contracts.load_day_chain_contract（pipeline）"
      },
      {
        "path": "contracts/day-chain/fields-source.json",
        "role": "BUSINESS_PIPELINE_DESIGN_CONTRACT_MODULE",
        "contract": "STOCK-A-DAY-CHAIN/R11",
        "consumer": "stock_a.contracts.load_day_chain_contract（source fields）"
      },
      {
        "path": "contracts/day-chain/fields-core.json",
        "role": "BUSINESS_PIPELINE_DESIGN_CONTRACT_MODULE",
        "contract": "STOCK-A-DAY-CHAIN/R11",
        "consumer": "stock_a.contracts.load_day_chain_contract（Core fields）"
      },
      {
        "path": "contracts/day-chain/fields-profile.json",
        "role": "BUSINESS_PIPELINE_DESIGN_CONTRACT_MODULE",
        "contract": "STOCK-A-DAY-CHAIN/R11",
        "consumer": "stock_a.contracts.load_day_chain_contract（cross/Profile rules）"
      },
      {
        "path": "contracts/day-chain/fields-control.json",
        "role": "BUSINESS_PIPELINE_DESIGN_CONTRACT_MODULE",
        "contract": "STOCK-A-DAY-CHAIN/R11",
        "consumer": "stock_a.contracts.load_day_chain_contract（control fields）"
      },
      {
        "path": "contracts/day-chain/research.json",
        "role": "BUSINESS_PIPELINE_DESIGN_CONTRACT_MODULE",
        "contract": "STOCK-A-DAY-CHAIN/R11",
        "consumer": "stock_a.contracts.load_day_chain_contract（research rules）"
      },
      {
        "path": "contracts/day-chain/service.json",
        "role": "BUSINESS_PIPELINE_DESIGN_CONTRACT_MODULE",
        "contract": "STOCK-A-DAY-CHAIN/R11",
        "consumer": "stock_a.contracts.load_day_chain_contract（service contract）"
      },
      {
        "path": "contracts/day-chain/policies.json",
        "role": "BUSINESS_PIPELINE_DESIGN_CONTRACT_MODULE",
        "contract": "STOCK-A-DAY-CHAIN/R11",
        "consumer": "stock_a.contracts.load_day_chain_contract（policies）"
      }
    ],
    "private_files": {
      "root": "private",
      "git_allowed": false,
      "allowed_role": "SECRET_CONNECTION_KEYS_ONLY_NOT_BUSINESS_TEST_OR_RESULT_DATA",
      "registered_files": [
        {
          "path": "private/postgresql.credentials.json",
          "schema": "STOCK-A-PG-CREDENTIALS/R1",
          "allowed_keys": [
            "schema",
            "host",
            "port",
            "database",
            "username",
            "password"
          ],
          "consumer": "stock_a.storage.postgres.identity.inspect_postgres（仅pg-identity）",
          "lifecycle": "STOCK_A_PG_DSN优先；仅在其缺失时由pg-identity进程内存读取；不得输出、摘要、记录、复制或传入子进程参数"
        }
      ]
    },
    "deployment_connection_environment": {
      "name": "STOCK_A_PG_DEPLOYMENT_DSN",
      "consumer": "stock_a.storage.postgres.identity._deployment_storage_checks",
      "role": "EXISTING_SUPERUSER_DEPLOYMENT_VERIFICATION_ONLY",
      "target": "127.0.0.1:5432/stock_a",
      "lifecycle": "可选安全环境变量；与stock_a业务连接分离；仅作只读实际簇、存储路径和业务后端绑定核验；缺失时拒绝写入、发布和迁移；不得输出、记录或复制秘密"
    },
    "unknown_files": "REJECT",
    "outside_root_or_link_escape": "REJECT",
    "recursive_autoload": false,
    "test_configuration_or_fixture_allowed": false,
    "daily_job_configuration_writes_allowed": false,
    "secrets_via_secure_store_or_secret_environment_allowed": true,
    "environment_or_cli_config_path_outside_root_allowed": false,
    "runtime_enforcement_implementation_required": true,
    "program_modes": {
      "DEV": "CURRENT_SOURCE_PACKAGE",
      "INSTALLED": "VERIFIED_INSTALLED_BINARY_AND_COMPILED_RESOURCES",
      "same_approved_configuration_root": true,
      "source_import_from_installed_forbidden": true,
      "whole_configuration_root_unavailable": "REJECT_NO_FALLBACK"
    }
  },
  "business_storage_policy": {
    "daily_persistent_business_files_allowed": false,
    "business_state_backend": "POSTGRESQL_TYPED_TABLES",
    "checkpoint_backend": "POSTGRESQL_BOUNDED_JOB_CURSORS",
    "runtime_cache_backend": "BOUNDED_MEMORY_OR_CONTROLLED_PG_TEMP",
    "raw_file_binary_or_full_payload_in_pg_allowed": false,
    "original_source_locator_is_runtime_dependency": false,
    "default_daily_source_archive_enabled": false
  },
