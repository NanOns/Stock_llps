{
  "contract": "STOCK-A-RUNTIME-DEFAULTS/R1",
  "paths": {
    "workspace_root": "G:/codex work/Stock A",
    "delivery_root": "G:/codex work/Stock A 交付",
    "release_root": "G:/codex work/Stock A 交付/发布包",
    "process_materials_root": "G:/codex work/Stock A 交付/过程资料",
    "reference_root": "G:/codex work/Stock A 交付/参考资料",
    "runtime_data_root": "G:/codex work/Stock A 交付/运行数据",
    "private_configuration_root": "G:/codex work/Stock A 交付/运行配置",
    "temporary_root": "G:/codex_tmp",
    "test_root": "G:/codex_tmp/test_temp"
  },
  "services": {
    "production": {
      "host": "127.0.0.1",
      "port": 28765
    },
    "development": {
      "host": "127.0.0.1",
      "port": 28766
    }
  },
  "postgresql": {
    "host": "127.0.0.1",
    "port": 5432,
    "database": "market_research",
    "business_schema": "v4",
    "data_directory": "G:/Postgres/data",
    "wal_directory": "G:/Postgres/data/pg_wal",
    "log_directory": "G:/Postgres/log",
    "manual_export_and_backup_directory": "G:/Postgres/backups",
