      "schemas": {
        "Field": {
          "required": [
            "value",
            "quality",
            "reason_codes",
            "unit",
            "field_id",
            "input_ref",
            "window_ref",
            "coordinate_ref"
          ],
          "quality": [
            "OBSERVED",
            "UNKNOWN_DATA",
            "NOT_APPLICABLE"
          ],
          "decimal_encoding": "exact decimal string; count integer"
        },
        "Context": {
          "required": [
            "context_kind",
            "context_token",
            "publication_id",
            "manifest_id",
            "scope",
            "snapshot_date",
            "data_date",
            "source_cutoff",
            "rule_versions",
            "forward_revision",
            "model_revision",
            "api_schema_version",
            "ui_build_id"
          ],
          "model_revision": "nullable NOT_ENABLED when FEP scope disabled",
          "context_kinds": [
            "RESEARCH",
            "OPERATIONAL"
          ],
          "nullable_operational_fields": [
            "publication_id",
            "manifest_id",
            "snapshot_date",
            "data_date",
            "source_cutoff",
            "rule_versions",
            "forward_revision",
            "model_revision"
          ]
        },
        "List": {
          "required": [
            "context",
            "items",
            "total_count",
            "returned_count",
            "next_cursor",
            "counts_by_status",
            "capabilities"
          ]
        },
        "Detail": {
          "required": [
            "context",
            "entity",
            "components",
            "capabilities",
            "explanations"
          ],
          "entity": "nullable only aggregate overview/market/diagnostics; otherwise EntityRef"
        },
        "Error": {
          "required": [
            "code",
            "message_zh",
            "request_id",
            "context",
            "details",
            "retryable"
          ]
        },
        "OperationReceipt": {
          "required": [
            "request_key",
            "status",
            "operation_id",
            "current_revision",
            "context",
            "reason_codes"
          ],
          "async_job_status_code": 202
        },
        "Chart": {
          "required": [
            "context",
            "entity",
            "period",
            "mode",
            "bars",
            "calendar_gaps",
            "coordinate",
            "ma",
            "anchors"
          ]
        },
        "Compare": {
          "required": [
            "context",
            "objects",
            "dates",
            "fields",
            "values",
            "comparison_status",
            "incomparable_reasons"
          ]
        },
        "Bootstrap": {
          "required": [
            "context",
            "available_trade_dates",
            "capabilities",
            "api_schema_version",
            "ui_build_id"
          ]
        }
      },
      "pagination": {
        "default": 50,
        "maximum": 200,
        "cursor_binding": [
          "context",
          "data_date",
          "filter",
          "sort",
          "last_business_key",
          "subrevision"
        ],
        "true_sql_pagination": true
      },
      "search": {
        "maximum_unicode_chars": 80,
        "normalization": "NFKC_CASEFOLD",
        "matching": "symbol/name/date-effective alias prefix",
        "order": [
          "exact symbol",
          "exact name",
          "symbol prefix",
          "name_alias prefix",
          "entity_id"
        ]
      },
      "chart": {
        "periods": [
          "D",
          "W",
          "M"
        ],
        "modes": [
          "closed",
          "as_of"
        ],
        "default_limit": 250,
        "maximum_limit": 1000,
        "coordinate_target": "data_date",
        "unknown_gap": "explicit no candle",
        "suspension": "no synthetic candle"
      },
      "compare": {
        "maximum_objects": 8,
        "maximum_dates": 2,
        "cross_type": "only registered same semantic/unit fields",
        "history": "exact owner/date/context; no current snapshot substitution"
      },
      "http_errors": {
        "400": "INVALID_ARGUMENT",
        "403": "ACCESS_DENIED",
        "404": "ENTITY_OR_OBSERVATION_NOT_FOUND",
        "409": "CONTEXT_MISMATCH_OR_STALE_OR_REVISION_CONFLICT",
        "429": "BUDGET_EXCEEDED",
        "500": "ENGINEERING_ERROR",
        "503": "NO_ACCEPTED_PUBLICATION_OR_REQUIRED_CAPABILITY_NOT_READY"
      },
      "write_commands": {
        "focus": {
          "required": [
            "entity_id",
            "episode_id",
            "action",
            "expected_revision",
            "request_key"
          ],
          "note_max_chars": 2000
        },
        "jobs": {
          "required": [
            "action",
            "request_key",
            "context_token"
          ],
          "free_script_sql_or_source_path": false
        },
        "ack": {
          "required": [
            "request_key",
            "publication_id",
            "context_token",
            "data_date",
            "ui_build_id",
            "view_id",
            "rendered_required_component_ids"
          ],
          "current_required_render_only": true
        }
      },
      "view_defaults": {
        "stocks": "all; candidates/near_miss explicit tabs",
        "overview": "per type10 concept known cluster2; full count disclosed",
        "sectors": "industry/concept separate, priority known first, all statuses accessible",
        "focus": "automatic/pinned/archived separated; recency",
        "market": "four independent axes + composite and limit ladder",
        "diagnostics": "source/contracts/jobs/errors/identity/backlogs"
      },
      "frontend_race_policy": "request_generation+context/date/object must match before rendering or ACK",
      "required_capability_missing": "503_NOT_EMPTY_SUCCESS_OR_UNKNOWN_DATA",
      "get_side_effects": false,
      "filter_combination": "OR within repeated field, AND across fields; unknown by quality not fake enum; invalid values400",
      "sort_request": "field+ASC/DESC whitelist; duplicates/conflicts400; original research key order immutable",
      "operational_context": {
        "bootstrap_mode": "explicit mode=operational; no accepted Head required",
        "only_resources": [
          "diagnostics",
          "sources",
          "jobs",
          "job-actions"
        ],
        "business_routes": "REJECT_OPERATIONAL_CONTEXT",
        "fake_data_date_allowed": false
      }
    }
  }
}
